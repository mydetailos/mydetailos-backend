{
  "name": "my-detail-os-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "dev": "tsx watch src/index.ts",
    "render:build": "npm install && npm run db:generate && npx --yes prisma@6.19.3 migrate deploy && npm run build",
    "db:migrate:deploy": "npx --yes prisma@6.19.3 migrate deploy",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "prisma:generate": "npx --yes prisma@6.19.3 generate",
    "generate": "npx --yes prisma@6.19.3 generate",
    "db:generate": "npx --yes prisma@6.19.3 generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "test:collection-permissions": "tsx scripts/check-collection-permissions.ts",
    "test:permission-keys": "tsx scripts/check-permission-keys.ts",
    "test:collection-payloads": "tsx scripts/check-collection-payloads.ts",
    "test:rbac": "tsx scripts/check-rbac.ts",
    "test:staff-access": "tsx scripts/check-staff-access.ts",
    "test:job-card-pricing": "tsx scripts/check-job-card-pricing-guard.ts",
    "grant:job-card-pricing": "tsx scripts/grant-job-card-pricing.ts",
    "test:whatsapp-otp": "tsx --test scripts/whatsapp-login-otp.test.ts",
    "test:plan-catalog": "tsx --test scripts/plan-catalog.test.ts",
    "test:subscription-lock": "tsx --test scripts/subscription-lock.test.ts",
    "test:data-scope": "tsx --test scripts/data-scope.test.ts",
    "test:gst-settings": "tsx --test scripts/gst-settings.test.ts",
    "test:referral-eligibility": "tsx --test scripts/referral-eligibility.test.ts",
    "test:party-ledger": "tsx --test scripts/party-ledger-public.test.ts",
    "test:reminder-job": "tsx --test scripts/reminder-job.test.ts scripts/internal-job-auth.test.ts",
    "test:bootstrap-thin": "tsx scripts/check-bootstrap-thin.ts",
    "test:list-scope": "tsx scripts/check-list-scope.ts",
    "test:tenant-org": "tsx scripts/check-tenant-org-columns.ts",
    "test:rewards": "tsx --test src/lib/__tests__/company-target-engine.test.ts",
    "test:security": "npm run test:collection-permissions && npm run test:permission-keys && npm run test:collection-payloads && npm run test:rbac && npm run test:staff-access && npm run test:job-card-pricing && npm run test:data-scope && npm run test:gst-settings && npm run test:referral-eligibility && npm run test:bootstrap-thin && npm run test:list-scope && npm run test:tenant-org && npm run test:reminder-job && npm run test:subscription-lock",
    "saas:set-branch-limit": "tsx scripts/saas-set-branch-limit.ts",
    "saas:ensure-platform-owner": "tsx scripts/ensure-platform-owner.ts",
    "saas:force-one-branch": "tsx scripts/saas-force-one-branch.ts",
    "org:reset-data": "tsx scripts/reset-org-data.ts",
    "org:reset-data:dry-run": "tsx scripts/reset-org-data.ts --dry-run",
    "org:reset-data:confirm": "tsx scripts/reset-org-data.ts --confirm",
    "s3:setup-aws-public-read": "tsx scripts/s3-setup-aws-public-read.ts",
    "s3:setup-aws-policy-only": "tsx scripts/s3-setup-aws-public-read.ts --policy-only"
  },
  "prisma": {
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@prisma/client": "^6.19.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.16.5",
    "@types/pdfkit": "^0.17.6",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.0",
    "razorpay": "^2.9.8",
    "sharp": "^0.35.5",
    "svix": "^2.6.2",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.13.1",
    "typescript": "^5.9.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
