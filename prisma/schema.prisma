generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLATFORM_OWNER
  SUPER_ADMIN
  ADMIN
  BRANCH_MANAGER
  MANAGER
  SUPERVISOR
  RECEPTIONIST
  MECHANIC
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
  TRIAL
}

enum SubscriptionPaymentStatus {
  PAID
  PENDING
  PROCESSING
  FAILED
}

model Organization {
  id                   String                    @id
  name                 String
  slug                 String?                   @unique
  /**
   * SaaS account on/off — inactive orgs cannot use the studio app
   */
  isActive             Boolean                   @default(true)
  activatedAt          DateTime?
  deactivatedAt        DateTime?
  /**
   * PLATFORM_OWNER only — never exposed to studio APIs
   */
  internalNotes        String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  subscription         OrganizationSubscription?
  branches             Branch[]
  users                User[]
  customers            Customer[]
  vehicles             Vehicle[]
  appointments         Appointment[]
  parties              Party[]
  appJsonRows          AppJsonRow[]
  platformAuditLogs    PlatformAuditLog[]
  subscriptionPayments SubscriptionPayment[]
  subscriptionBills    SubscriptionBill[]
  partnerReferral      PlatformReferralCode?
  referralWallet       ReferralWallet?
  inspectionReports   InspectionReport[]
  inspectionTemplates InspectionTemplate[]
  inspectionUploads   InspectionUpload[]
  inspectionSendLogs  InspectionSendLog[]
}

model PlatformAuditLog {
  id             String        @id @default(cuid())
  /**
   * Null for platform-wide actions (settings/plans/referrals) that are not org-scoped.
   */
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          String
  action         String
  before         Json?
  after          Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

/**
 * Platform-managed referral codes for subscription discounts.
 */
model PlatformReferralCode {
  id             String   @id @default(cuid())
  code           String   @unique
  discountAmount Float    @default(1000)
  isActive       Boolean  @default(true)
  createdBy      String
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  /** Set when this code is the workshop’s shareable partner code (issued after trial conversion). */
  organizationId String?       @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum ReferralTransactionType {
  REFERRER_POINTS
  REFEREE_DISCOUNT
  POINTS_REDEEM
}

/** SaaS referrer ledger (spec: referral_wallets). */
model ReferralWallet {
  id             String                 @id @default(cuid())
  organizationId String                 @unique
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  points         Int                    @default(0)
  updatedAt      DateTime               @updatedAt
  createdAt      DateTime               @default(now())
  transactions   ReferralTransaction[]
}

/** SaaS referral ledger (spec: referral_transactions). */
model ReferralTransaction {
  id                   String                   @id @default(cuid())
  walletId             String
  wallet               ReferralWallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type                 ReferralTransactionType
  points               Int                      @default(0)
  amountInr            Float                    @default(0)
  referralCode         String
  sourceOrganizationId String?
  paymentId            String?
  notes                String?
  createdAt            DateTime                 @default(now())

  @@unique([paymentId, type])
  @@index([walletId, createdAt])
}

enum MarketingBannerAudience {
  TRIAL
  ACTIVE
  ALL
}

/** Platform-managed in-app banners shown in the workshop dashboard. */
model MarketingBanner {
  id        String                   @id @default(cuid())
  title     String
  body      String                   @default("")
  audience  MarketingBannerAudience  @default(TRIAL)
  enabled   Boolean                  @default(true)
  ctaLabel  String                   @default("Upgrade")
  ctaUrl    String                   @default("")
  sortOrder Int                      @default(0)
  createdBy String
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  @@index([enabled, audience, sortOrder])
}

/**
 * Singleton platform control-plane settings (id = "default").
 * Holds trial/billing defaults and optional plan catalog overrides.
 * Provider secrets (Twilio/Resend) stay in env — never stored here.
 */
model PlatformSettings {
  id        String   @id @default("default")
  payload   Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model OrganizationSubscription {
  id                  String                    @id @default(cuid())
  organizationId      String                    @unique
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planCode            String
  planName            String
  status              SubscriptionStatus        @default(ACTIVE)
  /**
   * Extensible caps; maxBranches null = unlimited
   */
  limits              Json
  maxBranchesOverride Int?
  maxUsersOverride    Int?
  contactUsUrl        String?
  /**
   * E.164 preferred, e.g. +919876543210 — used for mobile tel: dial
   */
  contactPhone        String?
  upgradeUrl          String?
  /**
   * Term length in months: 12 / 24 / 36
   */
  termMonths          Int                       @default(12)
  startsAt            DateTime?
  /**
   * End of paid period. Export lock when ≤30 days remain.
   */
  expiresAt           DateTime?
  /**
   * Legacy alias mirrored from expiresAt for older clients.
   */
  currentPeriodEnd    DateTime?
  paymentStatus       SubscriptionPaymentStatus @default(PAID)
  lastPaymentTxnId    String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  payments            SubscriptionPayment[]
  bills               SubscriptionBill[]
}

model SubscriptionPayment {
  id             String                    @id @default(cuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   OrganizationSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount         Float?
  currency       String                    @default("INR")
  status         SubscriptionPaymentStatus @default(PENDING)
  txnReference   String?
  method         String?
  notes          String?
  recordedBy     String?
  verifiedAt     DateTime?
  /** Payment provider: MANUAL | RAZORPAY */
  gatewayProvider   String?
  /** Razorpay order id (order_…) */
  gatewayOrderId    String?                  @unique
  /** Razorpay payment id (pay_…) */
  gatewayPaymentId  String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  bill           SubscriptionBill?

  @@index([organizationId, createdAt])
  @@index([subscriptionId, createdAt])
}

model SubscriptionBill {
  id               String                   @id @default(cuid())
  organizationId   String
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId   String
  subscription     OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  paymentId        String?                  @unique
  payment          SubscriptionPayment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  billNumber       String
  planName         String
  termMonths       Int
  /**
   * Human label e.g. "1 year", "2 years", "3 years"
   */
  termLabel        String
  periodStart      DateTime
  periodEnd        DateTime
  baseAmount       Float?
  extraBranchCost  Float?
  extraUserCost    Float?
  /**
   * Extra branches purchased with this bill (re-read at verification to re-derive maxBranchesOverride).
   */
  extraBranches    Int?
  /**
   * Extra users purchased with this bill (re-read at verification to re-derive maxUsersOverride).
   */
  extraUsers       Int?
  onboardingFee    Float?
  referralDiscount Float?
  gstPercent       Float?
  gstAmount        Float?
  totalAmount      Float?
  amount           Float?
  currency         String                   @default("INR")
  createdAt        DateTime                 @default(now())

  @@unique([organizationId, billNumber])
  @@index([organizationId, createdAt])
}

enum VehicleSegment {
  HATCHBACK
  SEDAN
  SUV
  LUXURY
  MUV
  COMPACT_SUV
  BIKE
}

enum FuelType {
  PETROL
  DIESEL
  CNG
  ELECTRIC
  HYBRID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

model Branch {
  id                String       @id
  name              String
  address           String
  phone             String
  isActive          Boolean      @default(true)
  qrCodeId          String?
  code              String?
  city              String?
  state             String?
  pincode           String?
  email             String?
  managerName       String?
  managerPhone      String?
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users             User[]
  attendanceRecords Attendance[]
  inspectionReports InspectionReport[]
  inspectionUploads InspectionUpload[]

  createdByUserId   String?
  updatedByUserId   String?

  @@index([organizationId])
}

model User {
  id                     String       @id
  name                   String
  email                  String       @unique
  phone                  String
  employeeCode           String?      @unique
  /**
   * Job title (distinct from UserRole).
   */
  designation            String?
  department             String?
  /**
   * Employment start date (yyyy-MM-dd). Separate from birthday and anniversary.
   */
  joiningDate            String?
  role                   UserRole
  branchId               String
  branch                 Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  organizationId         String
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  avatar                 String?
  isActive               Boolean      @default(true)
  emailVerified          Boolean      @default(false)
  attendancePin          String?
  isAttendanceTracked    Boolean      @default(true)
  baseSalary             Float?
  totalJobsCompleted     Int?
  totalIncentiveEarned   Int?
  birthday               String?
  anniversary            String?
  /**
   * Free-text HR notes (not used for auth).
   */
  notes                  String?
  passwordHash           String
  permissions            String[]     @default([])
  /**
   * When true, client should force a password change before using the app (set for auto-generated onboarding passwords).
   */
  mustChangePassword     Boolean      @default(false)
  /**
   * Staff user id (`User.id`) of the admin who last set the initial/onboarding password, when tracked.
   */
  passwordCreatedBy      String?
  /**
   * Last time the login password hash was replaced (create, reset, or authenticated change).
   */
  passwordUpdatedAt      DateTime?
  /**
   * SHA-256 hex of opaque reset token; cleared after reset or superseded by new request
   */
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  /**
   * Set on successful password or OTP login
   */
  lastLoginAt            DateTime?
  attendanceRecords      Attendance[]

  createdByUserId        String?
  updatedByUserId        String?

  @@index([organizationId])
}

model Customer {
  id             String       @id
  name           String
  phone          String
  email          String
  address        String
  referralCode   String
  referredBy     String?
  totalVisits    Int          @default(0)
  rewardPoints   Int          @default(0)
  walletBalance  Float        @default(0)
  lastVisitDate  String?
  notes          String?
  isInactive     Boolean      @default(false)
  emailVerified  Boolean      @default(false)
  avatar         String?
  createdAt      DateTime
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicles       Vehicle[]

  /**
   * Customer portal login (set by admin/staff; nullable until first password is issued).
   */
  passwordHash       String?
  /**
   * When true, client should force a password change before using the portal.
   */
  mustChangePassword Boolean   @default(true)
  /**
   * Staff `User.id` who last set the customer's portal password, when tracked.
   */
  passwordCreatedBy  String?
  /**
   * Last time the portal login password hash was replaced.
   */
  passwordUpdatedAt  DateTime?
  /**
   * Set on successful customer portal login.
   */
  lastLoginAt        DateTime?

  createdByUserId    String?
  updatedByUserId    String?

  @@index([organizationId])
  @@index([referralCode])
}

model Vehicle {
  id                    String         @id
  customerId            String
  customer              Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName          String
  registrationNumber    String
  make                  String
  model                 String
  segment               VehicleSegment
  variant               String?
  fuelType              FuelType
  color                 String
  year                  Int
  notes                 String?
  odometer              Int?
  insuranceProvider     String?
  insurancePolicyNumber String?
  insuranceDueDate      String?
  vinNumber             String?
  previousOwners        Json?
  organizationId        String
  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdByUserId       String?
  updatedByUserId       String?

  @@index([organizationId])
  @@index([customerId])
  @@index([registrationNumber])
}

/**
 * Staff attendance punches (check-in / check-out). One row per shift. `date`/`checkIn`/`checkOut` are the staff member's LOCAL calendar values (yyyy-MM-dd / HH:mm) so server timezone never shifts them.
 */
model Attendance {
  id              String           @id @default(cuid())
  staffId         String
  staff           User             @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffName       String
  staffRole       UserRole
  branchId        String
  branch          Branch           @relation(fields: [branchId], references: [id])
  date            String
  checkIn         String?
  checkOut        String?
  durationMinutes Int?
  status          AttendanceStatus
  qrScanned       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([branchId, date])
  @@index([staffId, branchId, date])
}

enum PartyKind {
  CUSTOMER
  SUPPLIER
}

enum OpeningBalanceSide {
  TO_COLLECT
  TO_PAY
}

/**
 * MyBillBook-style party profile (customer or supplier).
 */
model Party {
  id                 String                 @id
  kind               PartyKind
  name               String
  category           String?
  mobile             String?
  email              String?
  gstin              String?
  pan                String?
  billingAddress     String?
  shippingAddress    String?
  openingBalance     Float                  @default(0)
  openingBalanceSide OpeningBalanceSide?
  creditPeriodDays   Int?
  creditLimit        Float?
  contactPersonName  String?
  dateOfBirth        String?
  customerId         String?                @unique
  vendorKey          String?
  organizationId     String
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  shippingAddresses  PartyShippingAddress[]
  bankAccounts       PartyBankAccount[]
  customFields       PartyCustomField[]

  createdByUserId    String?
  updatedByUserId    String?

  @@index([kind])
  @@index([vendorKey])
  @@index([organizationId])
}

model PartyShippingAddress {
  id        String  @id @default(cuid())
  partyId   String
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  name      String
  street    String
  state     String?
  pincode   String?
  city      String?
  isDefault Boolean @default(false)

  @@index([partyId])
}

model PartyBankAccount {
  id                String  @id @default(cuid())
  partyId           String
  party             Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)
  accountNumber     String
  ifsc              String?
  accountHolderName String?
  bankName          String?
  branchName        String?
  upiId             String?

  @@index([partyId])
}

model PartyCustomField {
  id      String @id @default(cuid())
  partyId String
  party   Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)
  key     String
  value   String

  @@index([partyId])
}

/**
 * Soft-hide party from list (MyBillBook-style).
 */
model PartyHidden {
  partyId String @id
}

/**
 * Relational mirror for appointments/bookings previously stored only in AppJsonRow.
 * `kind` and `status` remain stringly typed to preserve legacy payload compatibility.
 */
model Appointment {
  id                    String       @id
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookingId             String?
  appointmentNumber     String?
  kind                  String?
  branchId              String?
  customerId            String?
  customerName          String?
  customerPhone         String?
  vehicleId             String?
  vehicleRegNumber      String?
  vehicleMakeModel      String?
  serviceType           String?
  mechanicId            String?
  mechanicName          String?
  date                  String?
  time                  String?
  status                String?
  jobCardId             String?
  notes                 String?
  whatsappSent          Boolean?
  reminderSent          Boolean?
  priceGrandTotal       Float?
  advancePaid           Float?
  customerAddress       String?
  vehiclePickupRequired Boolean?
  vehiclePickupStatus   String?
  payload               Json?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  createdByUserId       String?
  updatedByUserId       String?

  @@index([organizationId, date])
  @@index([organizationId, branchId])
  @@index([organizationId, customerId])
  @@index([organizationId, vehicleId])
}

/**
 * JSON documents keyed by collection name + entity id (e.g. jobCards / jc-001).
 * `organizationId` scopes rows per tenant (Phase 5). PK stays (collection, entityId);
 * entity ids must remain globally unique across orgs (enforced on write).
 * Appointment rows (`collection=appointments`) may include:
 * - `vehiclePickupRequired` (Boolean | null)
 * - `vehiclePickupStatus` (String | null)
 */
model AppJsonRow {
  collection     String
  entityId       String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payload        Json
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt

  @@id([collection, entityId])
  @@index([organizationId, collection])
  @@index([organizationId, collection, createdAt(sort: Desc)], map: "AppJsonRow_org_col_created_idx")
}

model InspectionReport {
  id             String                    @id @default(cuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reportNumber   String
  revision       Int                       @default(1)
  status         String                    @default("DRAFT")
  data           Json
  finalizedAt    DateTime?
  deletedAt      DateTime?
  createdBy      String
  updatedBy      String
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  versions       InspectionReportVersion[]
  uploads        InspectionUpload[]
  sendLogs       InspectionSendLog[]

  @@unique([organizationId, reportNumber])
  @@index([organizationId, deletedAt, updatedAt(sort: Desc)])
  @@index([organizationId, branchId, updatedAt(sort: Desc)])
  @@index([organizationId, status, updatedAt(sort: Desc)])
}

model InspectionReportVersion {
  id             String           @id @default(cuid())
  reportId       String
  report         InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  revision       Int
  data           Json
  documentKey    String?
  finalizedBy    String
  finalizedAt    DateTime         @default(now())
  createdAt      DateTime         @default(now())

  @@unique([reportId, revision])
  @@index([reportId, finalizedAt(sort: Desc)])
}

model InspectionTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sections       Json
  terms          Json
  createdBy      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, updatedAt(sort: Desc)])
}

model InspectionUpload {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  reportId       String?
  report         InspectionReport? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  objectKey      String             @unique
  mimeType       String
  byteSize       Int
  expiresAt      DateTime?
  cleaning       Boolean           @default(false)
  createdBy      String
  createdAt      DateTime           @default(now())

  @@index([organizationId, branchId, reportId])
  @@index([expiresAt])
}

model InspectionSendLog {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportId         String
  report           InspectionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  revision         Int
  requestId        String
  channel          String
  recipient        String
  status           String           @default("QUEUED")
  documentKey      String
  providerMessageId String?
  providerError    String?
  sentBy           String
  sentAt           DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([organizationId, requestId])
  @@index([organizationId, sentAt(sort: Desc)])
  @@index([reportId, revision, sentAt(sort: Desc)])
}
